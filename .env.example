# --- Control bot (official Discord application) --------------------------------
# https://discord.com/developers/applications → Bot → Token
DISCORD_BOT_TOKEN=
# Server the slash commands are registered in
DISCORD_GUILD_ID=
# Optional comma-separated role IDs allowed to use /grafcast (empty = everyone)
DISCORD_ALLOWED_ROLE_IDS=

# --- Streamer account (regular user account, see README warning) -------------
STREAMER_TOKEN=

# --- Grafana ------------------------------------------------------------------
GRAFANA_URL=https://grafana.example.com
GRAFANA_PLAYLIST_UID=
# anonymous | token | login
GRAFANA_AUTH=anonymous
# Service account token (GRAFANA_AUTH=token)
GRAFANA_TOKEN=
# Local Grafana user (GRAFANA_AUTH=login)
GRAFANA_USERNAME=
GRAFANA_PASSWORD=
# Optional: dark | light
GRAFANA_THEME=

# --- Stream -------------------------------------------------------------------
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=15
STREAM_BITRATE_KBPS=4000
# H264 | H265
STREAM_CODEC=H264

# --- Misc ---------------------------------------------------------------------
# Use a system Chrome/Chromium instead of the one bundled with Puppeteer
CHROME_EXECUTABLE_PATH=
# debug | info | warn | error
LOG_LEVEL=info
